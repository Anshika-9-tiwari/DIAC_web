generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Enquiry_Form {
  id String @id @default(cuid())

  // Personal Details
  firstname String
  lastname  String?
  phone     String
  email     String?

  // General Enquiry
  course  String?
  message String?

  // Customized Industrial Training
  organization        String?
  industry            String?
  trainingRequirement String?
  participants        Int?
  trainingMode        TrainingMode?

  // Enquiry Type
  enquiryType EnquiryType @default(GENERAL)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([email])
  @@index([phone])
  @@index([enquiryType])
  @@index([createdAt])
}

enum EnquiryType {
  GENERAL
  CUSTOMIZED_TRAINING
  BROCHURE
}

enum TrainingMode {
  ONLINE
  OFFLINE
  ON_SITE
}
